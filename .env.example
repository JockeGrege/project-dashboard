# Copy to .env for local development.

# Which backend the app talks to:
#   memory   - seeded in-memory store, no Firebase, no setup (default)
#   emulator - local Firebase Emulator Suite (run: npm run emulators)
#   live     - production Firestore + Auth
VITE_FIREBASE_TARGET=memory

# Firebase web config for progress-board-d03d1.
# NOT secrets (they ship in the client bundle); kept here so CI injects them per
# environment. Required when VITE_FIREBASE_TARGET is "emulator" or "live".
VITE_FIREBASE_API_KEY=AIzaSyDiaeiBFM5RetsJpYXdJ_1jXKqfa_msg5o
VITE_FIREBASE_AUTH_DOMAIN=progress-board-d03d1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=progress-board-d03d1
VITE_FIREBASE_STORAGE_BUCKET=progress-board-d03d1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=742672862359
VITE_FIREBASE_APP_ID=1:742672862359:web:05222ffb0783ad916cadd2

# The single account allowed to read/write. Unknown until first sign-in: leave as
# __REPLACE_ME__ and the app shows your UID in a banner once you sign in, then
# paste it here, into the GitHub Actions secret, and into firestore.rules.
VITE_ALLOWED_UID=__REPLACE_ME__
